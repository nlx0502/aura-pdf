{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura PDF",
  "version": "0.1.0",
  "identifier": "fr.aurapdf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aura PDF",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0E0F12",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: http://aura.localhost aura:; connect-src 'self' ipc: http://ipc.localhost http://aura.localhost aura:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aura PDF",
    "copyright": "© Aura PDF contributors — licence MIT",
    "category": "Productivity",
    "shortDescription": "Lire, annoter et signer vos PDF",
    "longDescription": "Aura PDF est un lecteur et éditeur PDF libre, gratuit et hors ligne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/pdfium.dll": "resources/pdfium/pdfium.dll"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Document PDF",
        "description": "Document PDF",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
